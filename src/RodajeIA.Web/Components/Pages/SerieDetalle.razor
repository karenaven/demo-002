@page "/series/{Id:int}"
@inject SeriesService SeriesService
@inject PersonajesService PersonajesService
@inject EpisodiosService EpisodiosService
@inject NavigationManager Navegacion

<PageTitle>@(serie?.Nombre ?? "Serie") · RodajeIA</PageTitle>

@if (cargando)
{
    <p>Cargando…</p>
}
else if (serie is null)
{
    <h1>Serie no encontrada</h1>
    <p><a href="">Volver a las series</a></p>
}
else
{
    <p><a href="">← Series</a></p>

    @if (nombreSerie is not null)
    {
        <form class="fila" @onsubmit="GuardarNombreAsync">
            <input @bind="nombreSerie" aria-label="Nombre de la serie" />
            <button type="submit">Guardar</button>
            <button type="button" class="secundario" @onclick="() => { nombreSerie = null; erroresSerie = []; }">Cancelar</button>
        </form>
    }
    else
    {
        <div class="fila titulo">
            <h1>@serie.Nombre</h1>
            <button type="button" class="secundario" @onclick="() => nombreSerie = serie.Nombre">Editar nombre</button>
            <BotonEliminar Texto="Eliminar serie"
                           Pregunta="Se borran la serie, sus hojas de personaje y sus episodios con todas sus escenas, bloques y variantes."
                           OnConfirmar="EliminarSerieAsync" />
        </div>
    }
    <Errores Mensajes="erroresSerie" />

    <section>
        <h2>Personajes</h2>
        @if (personajes.Count == 0)
        {
            <p class="vacio">Todavía no hay hojas de personaje.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Nombre</th><th>Edad</th><th>Rol</th><th>Peinado</th><th>Vestuario</th><th>Heridas/marcas</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var personaje in personajes)
                    {
                        <tr>
                            <td>@personaje.Nombre</td>
                            <td>@personaje.Edad</td>
                            <td>@personaje.Rol</td>
                            <td>@personaje.Peinado</td>
                            <td>@personaje.Vestuario</td>
                            <td>@personaje.Heridas</td>
                            <td class="fila">
                                <button type="button" class="secundario" @onclick="() => EditarHoja(personaje)">Editar</button>
                                <BotonEliminar Pregunta="@($"Se borran la hoja de {personaje.Nombre} y todas sus variantes, también las de escenas ya generadas.")"
                                               OnConfirmar="() => EliminarHojaAsync(personaje.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <details open="@(personajes.Count == 0 || hojaEditada is not null)">
            <summary>@(hojaEditada is null ? "Nueva hoja de personaje" : $"Editar la hoja de {hojaEditada.Nombre}")</summary>
            <EditForm Model="hoja" OnValidSubmit="GuardarHojaAsync" FormName="hoja-personaje" class="formulario">
                <DataAnnotationsValidator />
                <label>Nombre <small>(como aparece en el guion, con mayúscula inicial y tildes)</small>
                    <InputText @bind-Value="hoja.Nombre" />
                </label>
                <ValidationMessage For="() => hoja.Nombre" />
                <label>Edad <InputText @bind-Value="hoja.Edad" /></label>
                <ValidationMessage For="() => hoja.Edad" />
                <label>Descripción física (incluye voz) <InputTextArea @bind-Value="hoja.DescripcionFisica" rows="3" /></label>
                <ValidationMessage For="() => hoja.DescripcionFisica" />
                <label>Peinado <InputText @bind-Value="hoja.Peinado" /></label>
                <ValidationMessage For="() => hoja.Peinado" />
                <label>Vestuario <InputText @bind-Value="hoja.Vestuario" /></label>
                <ValidationMessage For="() => hoja.Vestuario" />
                <label>Heridas/marcas <small>(opcional)</small> <InputText @bind-Value="hoja.Heridas" /></label>
                <label>Personalidad <InputTextArea @bind-Value="hoja.Personalidad" rows="2" /></label>
                <ValidationMessage For="() => hoja.Personalidad" />
                <label>Rol <InputText @bind-Value="hoja.Rol" /></label>
                <ValidationMessage For="() => hoja.Rol" />
                @if (hojaEditada is not null)
                {
                    <p class="aviso">
                        Los prompts de las escenas ya generadas van a usar la hoja nueva. Si cambiás el nombre,
                        volvé a cargar el guion para que se detecte el personaje con el nombre nuevo.
                    </p>
                }
                <Errores Mensajes="erroresPersonaje" />
                <div class="fila">
                    <button type="submit">@(hojaEditada is null ? "Crear personaje" : "Guardar cambios")</button>
                    @if (hojaEditada is not null)
                    {
                        <button type="button" class="secundario" @onclick="CancelarHoja">Cancelar</button>
                    }
                </div>
            </EditForm>
        </details>
    </section>

    <section>
        <h2>Episodios</h2>
        @if (episodios.Count == 0)
        {
            <p class="vacio">Todavía no hay episodios.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Número</th><th>Título</th><th>Guion</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var episodio in episodios)
                    {
                        <tr>
                            <td>@episodio.Numero</td>
                            <td>
                                @if (episodioEditado == episodio.Id)
                                {
                                    <form class="fila" @onsubmit="GuardarTituloAsync">
                                        <input @bind="tituloEpisodio" aria-label="Título" />
                                        <button type="submit">Guardar</button>
                                        <button type="button" class="secundario" @onclick="CancelarTitulo">Cancelar</button>
                                    </form>
                                }
                                else
                                {
                                    <a href="episodios/@episodio.Id">@episodio.Titulo</a>
                                }
                            </td>
                            <td>@(episodio.Guion is null ? "Sin guion" : "Cargado")</td>
                            <td class="fila">
                                <a href="cargar-guion?serie=@serie.Id&episodio=@episodio.Id">Cargar guion</a>
                                <button type="button" class="secundario" @onclick="() => EditarTitulo(episodio)">Editar título</button>
                                <BotonEliminar Pregunta="@($"Se borran el episodio {episodio.Numero} con su guion, escenas, bloques y variantes.")"
                                               OnConfirmar="() => EliminarEpisodioAsync(episodio.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Errores Mensajes="erroresTitulo" />
        }

        <EditForm Model="nuevoEpisodio" OnValidSubmit="CrearEpisodioAsync" FormName="nuevo-episodio" class="fila">
            <DataAnnotationsValidator />
            <InputNumber @bind-Value="nuevoEpisodio.Numero" placeholder="Número" aria-label="Número" class="corto" />
            <InputText @bind-Value="nuevoEpisodio.Titulo" placeholder="Título" aria-label="Título" />
            <button type="submit">Crear episodio</button>
            <ValidationSummary class="errores" />
        </EditForm>
        <Errores Mensajes="erroresEpisodio" />
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool cargando = true;
    private Serie? serie;
    private List<Personaje> personajes = [];
    private List<Episodio> episodios = [];
    private string? nombreSerie;
    private DatosPersonaje hoja = new();
    private Personaje? hojaEditada;
    private DatosEpisodio nuevoEpisodio = new();
    private int? episodioEditado;
    private string? tituloEpisodio;
    private IReadOnlyList<string> erroresSerie = [];
    private IReadOnlyList<string> erroresPersonaje = [];
    private IReadOnlyList<string> erroresEpisodio = [];
    private IReadOnlyList<string> erroresTitulo = [];

    protected override async Task OnParametersSetAsync()
    {
        serie = await SeriesService.ObtenerAsync(Id);
        if (serie is not null)
        {
            personajes = await PersonajesService.ListarAsync(Id);
            episodios = await EpisodiosService.ListarAsync(Id);
        }

        cargando = false;
    }

    private async Task GuardarNombreAsync()
    {
        var resultado = await SeriesService.EditarAsync(Id, nombreSerie);
        erroresSerie = resultado.Errores;
        if (resultado.Ok)
        {
            nombreSerie = null;
            serie = await SeriesService.ObtenerAsync(Id);
        }
    }

    private async Task EliminarSerieAsync()
    {
        await SeriesService.EliminarAsync(Id);
        Navegacion.NavigateTo("");
    }

    private void EditarHoja(Personaje personaje)
    {
        hojaEditada = personaje;
        hoja = DatosPersonaje.De(personaje);
        erroresPersonaje = [];
    }

    private void CancelarHoja()
    {
        hojaEditada = null;
        hoja = new();
        erroresPersonaje = [];
    }

    private async Task GuardarHojaAsync()
    {
        var resultado = hojaEditada is null
            ? await PersonajesService.CrearAsync(Id, hoja)
            : await PersonajesService.EditarAsync(hojaEditada.Id, hoja);
        erroresPersonaje = resultado.Errores;
        if (resultado.Ok)
        {
            CancelarHoja();
            personajes = await PersonajesService.ListarAsync(Id);
        }
    }

    private async Task EliminarHojaAsync(int personajeId)
    {
        await PersonajesService.EliminarAsync(personajeId);
        if (hojaEditada?.Id == personajeId)
        {
            CancelarHoja();
        }

        personajes = await PersonajesService.ListarAsync(Id);
    }

    private async Task CrearEpisodioAsync()
    {
        var resultado = await EpisodiosService.CrearAsync(Id, nuevoEpisodio);
        erroresEpisodio = resultado.Errores;
        if (resultado.Ok)
        {
            nuevoEpisodio = new();
            episodios = await EpisodiosService.ListarAsync(Id);
        }
    }

    private void EditarTitulo(Episodio episodio)
    {
        episodioEditado = episodio.Id;
        tituloEpisodio = episodio.Titulo;
        erroresTitulo = [];
    }

    private void CancelarTitulo()
    {
        episodioEditado = null;
        erroresTitulo = [];
    }

    private async Task GuardarTituloAsync()
    {
        var resultado = await EpisodiosService.EditarTituloAsync(episodioEditado!.Value, tituloEpisodio);
        erroresTitulo = resultado.Errores;
        if (resultado.Ok)
        {
            episodioEditado = null;
            episodios = await EpisodiosService.ListarAsync(Id);
        }
    }

    private async Task EliminarEpisodioAsync(int episodioId)
    {
        await EpisodiosService.EliminarAsync(episodioId);
        episodios = await EpisodiosService.ListarAsync(Id);
    }
}
